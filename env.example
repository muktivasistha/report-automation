# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git — add it to .gitignore
# ─────────────────────────────────────────────────────────────────

# PostgreSQL Database
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME_ANALYTICS=analytics_db
DB_NAME_MAIN=main_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Email (Gmail App Password — NOT your main Gmail password)
# How to get one: https://support.google.com/accounts/answer/185833
SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
RECIPIENT_EMAILS=person1@example.com,person2@example.com
